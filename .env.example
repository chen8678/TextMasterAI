# 环境变量示例（复制为仓库根 .env 与/或 backend/.env；勿提交真实密钥）
# Django 从 backend/.env 加载（override=False）；Compose 注入变量优先生效。
#
# 本地 infra：DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5433/ai_qa_system
# 详见 docs/LOCAL_DEV.md / docs/guides/DEPLOY.md

# 生产：长度>=40、禁止 django-insecure 前缀；本地可用占位后在 backend/.env 覆盖
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_40_CHARS
# 本地开发：backend/.env 中设 DEBUG=True（本文件可保留 False 示意生产默认）
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3009,http://127.0.0.1:3009
# 可选；未设时回退 CORS_ALLOWED_ORIGINS
# CSRF_TRUSTED_ORIGINS=http://localhost:3009,http://127.0.0.1:3009
# 反向代理 HTTPS 终结后设 true
# SECURE_HTTPS=false
# App 壳 Origin（合并进 CORS；Bearer 鉴权，不要求 credentials）
# APP_SHELL_ORIGINS=capacitor://localhost,http://localhost,http://localhost:3009

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5433/ai_qa_system
VECTORIZATION_SERVICE_URL=http://127.0.0.1:8001
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY

# 知识库上传上限（字节）
# KNOWLEDGE_UPLOAD_MAX_BYTES=104857600
# KNOWLEDGE_CHUNK_MAX_BYTES=8388608

# 限流
# THROTTLE_LOGIN=20/min
# THROTTLE_ASK_QUESTION=60/min
# THROTTLE_SANDBOX_TRIGGER=6/min
# THROTTLE_REGISTER=5/hour

# P0-08 免费日配额（问答次数）；全局 token 预算默认不启用
# USER_DAILY_ASK_LIMIT=50
# GLOBAL_DAILY_TOKEN_BUDGET=

# Celery（生产：ALWAYS_EAGER=false + Redis）
# CELERY_TASK_ALWAYS_EAGER=false
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# ENGLISH_REMINDER_BEAT=true

# ANALYTICS_ENABLED=true
