# 复制为 backend/.env 后在云机上按需修改（勿提交仓库）
# 第二套端口约定：前端入口 3010，本后端 8010；PostgreSQL/向量服务复用现有端口。

SECRET_KEY=请改为与旧环境不同的随机串

DEBUG=False

# 云机公网 IP 或域名，逗号分隔
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,你的云机IP或域名

# 浏览器访问前端的来源（必须包含 http://云机IP:3010 ，教师开放端口后同学用这个地址）
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3010,http://localhost:3010,http://你的云机IP:3010

# 复用现有 Postgres（宿主映射端口一般为 5433），库名必须新建，勿与旧版共用同一 database
DATABASE_URL=postgresql://postgres:你的密码@127.0.0.1:5433/ai_qa_system_v3010

# 复用现有向量服务（宿主一般为 8001）
VECTORIZATION_SERVICE_URL=http://127.0.0.1:8001

# AI 密钥（与旧环境相同或单独一套均可）
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=

# 上传上限（字节），可与 backend 默认一致
KNOWLEDGE_UPLOAD_MAX_BYTES=104857600
KNOWLEDGE_CHUNK_MAX_BYTES=8388608

# 说明：默认 settings 使用 Django 内存缓存（LocMem），健康检查里的 redis 字段实际测的是默认 cache。
# 若你在线上改过 CACHES 指 Redis，请从旧环境 .env 复制对应配置。
